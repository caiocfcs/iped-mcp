# Endpoints IPED — use UMA das duas opções. IPED_ENDPOINTS e IPED_URL juntas
# geram erro explícito no startup.

# Múltiplos endpoints (ids únicos, separados por vírgula): id=url,id2=url2
IPED_ENDPOINTS=ep1=http://localhost:1234,ep2=http://localhost:1235

# Alternativa: um único endpoint (recebe o id `default`).
# IPED_URL=http://localhost:1234

# Paralelismo de fetch (workers). Padrão: 32.
IPED_MCP_WORKERS=32

# Pasta de exportações das tools (CSV/PDF/JSON). Padrão: /tmp/iped_mcp/exports
# IPED_MCP_EXPORTS_DIR=/tmp/iped_mcp/exports

# --- Timeouts por classe de operacao, em segundos (default entre parenteses).
# IPED_MCP_TIMEOUT_DEFAULT=30            (operacoes curtas: sources, bookmarks)
# IPED_MCP_TIMEOUT_SEARCH=30             (busca /search)
# IPED_MCP_TIMEOUT_PROPS=90              (/docs/{id} com propriedades)
# IPED_MCP_TIMEOUT_TEXT=60               (/text, texto extraido)
# IPED_MCP_TIMEOUT_CONNECT_DOWNLOAD=10   (download /content, /thumb: connect)
# IPED_MCP_TIMEOUT_READ_DOWNLOAD=120     (download /content, /thumb: leitura)
